# ============================================================
# 2048 桌面版（Python + pygame）· Git 忽略规则
# 项目：games/2048    开发工具：IntelliJ IDEA / PyCharm
# ============================================================

# ---------- Python 字节码与编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
__pypackages__/

# ---------- 依赖与构建产物 ----------
# PyInstaller / 打包输出
build/
dist/
*.manifest
*.spec
# 本项目需要把打包配置入库（构建入口），单独保留
!2048.spec
!version_info.txt

# 通用分发产物
*.egg-info/
*.egg
wheels/
sdist/
downloads/
.installed.cfg
MANIFEST

# 本项目生成的 exe（assets 下的图标/字体必须入库，故不忽略 *.ico/*.ttc）
*.exe

# ---------- 测试与静态检查缓存 ----------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# ---------- 运行期产物与日志 ----------
*.log
crash.log
# 存档默认写入 %APPDATA%\2048Desktop，若调试时改写到工程内，也不入库
save.json
save.tmp

# ---------- JetBrains IDEA / PyCharm ----------
# 整目录忽略：workspace.xml、tasks.xml、shelf/、本地历史、运行配置等均为本机个人数据。
# 若以后需要团队共享代码风格，把下面一行替换为：
#   .idea/*
#   !.idea/codeStyles/
#   !.idea/inspectionProfiles/
.idea/

# ---------- 其他编辑器 ----------
.vscode/
.spyderproject/
.spyproject/
.ropeproject/
tempCodeRunnerFile.py

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*.lnk

# ---------- 项目内必须提交的目录（显式声明，防止被上面的规则误伤）----------
# docs/   项目文档集
# assets/ 图标与随包字体（icon.ico / icon.png / fonts/msyh.ttc）
# tests/  单元测试
# src/    源码
